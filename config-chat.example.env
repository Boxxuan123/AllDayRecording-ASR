# Optional environment configuration. Do not put a real token in this file.
CHAT_DATA_BASE_URL=http://MAC_LAN_ADDRESS:8091
CHAT_DATA_TOKEN=REPLACE_LOCALLY_WITH_THE_MAC_SECRET
# Optional; use the existing configured Codex model when omitted.
# ALLDAY_CHAT_MODEL=
ALLDAY_CHAT_MODEL_TIMEOUT=180
# UI configuration is privately stored at <V3 state dir>/chat/connection.json.
