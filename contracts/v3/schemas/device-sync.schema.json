{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alldayrecording:contracts:v3:device-sync",
  "title": "DeviceSync",
  "$defs": {
    "ClientOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "base_revision",
        "payload"
      ],
      "properties": {
        "operation_id": {
          "$ref": "primitives.schema.json#/$defs/StableId"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "OperationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "status",
        "resource_revision",
        "error"
      ],
      "properties": {
        "operation_id": {
          "$ref": "primitives.schema.json#/$defs/StableId"
        },
        "status": {
          "$ref": "primitives.schema.json#/$defs/ClientOperationStatus"
        },
        "resource_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "error": {
          "oneOf": [
            {
              "$ref": "primitives.schema.json#/$defs/ApiError"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_results": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_id",
              "revision"
            ],
            "properties": {
              "resource_id": {
                "$ref": "primitives.schema.json#/$defs/StableId"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "Change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "resource_type",
        "resource_id",
        "revision",
        "operation",
        "resource"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "resource_type": {
          "$ref": "primitives.schema.json#/$defs/ResourceType"
        },
        "resource_id": {
          "$ref": "primitives.schema.json#/$defs/StableId"
        },
        "revision": {
          "$ref": "primitives.schema.json#/$defs/Revision"
        },
        "operation": {
          "$ref": "primitives.schema.json#/$defs/SyncOperation"
        },
        "resource": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "utterance"
              },
              "operation": {
                "const": "upsert"
              }
            },
            "required": [
              "resource_type",
              "operation"
            ]
          },
          "then": {
            "properties": {
              "resource": {
                "$ref": "utterance.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": "reminder"
              },
              "operation": {
                "const": "upsert"
              }
            },
            "required": [
              "resource_type",
              "operation"
            ]
          },
          "then": {
            "properties": {
              "resource": {
                "$ref": "reminder.schema.json"
              }
            }
          }
        }
      ]
    },
    "SyncRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_version",
        "cursor",
        "client_operations",
        "pull_limit"
      ],
      "properties": {
        "projection_version": {
          "const": 4
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "client_operations": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/ClientOperation"
          }
        },
        "pull_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "bootstrap": {
          "type": "boolean",
          "description": "Opt in to an immutable watermark snapshot when cursor is null or cursor-0."
        },
        "pull_bytes": {
          "type": "integer",
          "minimum": 16384,
          "maximum": 1048576,
          "description": "Soft UTF-8 response budget; one resource plus receipts may exceed it to make progress."
        }
      }
    },
    "SyncResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_version",
        "receipts",
        "changes",
        "next_cursor",
        "has_more",
        "server_time"
      ],
      "properties": {
        "projection_version": {
          "const": 4
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationReceipt"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          }
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1
        },
        "has_more": {
          "type": "boolean"
        },
        "server_time": {
          "$ref": "primitives.schema.json#/$defs/UtcDateTime"
        },
        "transaction_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Server write transaction duration, excluding lock wait and projection reads."
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SyncRequest"
    },
    {
      "$ref": "#/$defs/SyncResponse"
    }
  ]
}
