{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily event projection",
  "type": "object",
  "required": [
    "event_id",
    "revision",
    "daily_event_version",
    "local_date",
    "timezone",
    "start_at",
    "end_at",
    "category",
    "title",
    "participants",
    "linked_task_ids",
    "evidence_snapshots",
    "salience",
    "reconciliation"
  ],
  "properties": {
    "event_id": {
      "$ref": "primitives.schema.json#/$defs/StableId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "daily_event_version": {
      "type": "string"
    },
    "local_date": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "start_at": {
      "type": "string"
    },
    "end_at": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "kind",
          "label",
          "status"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "self",
              "known",
              "unknown"
            ]
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "person_id": {
            "$ref": "primitives.schema.json#/$defs/StableId"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "linked_task_ids": {
      "type": "array",
      "items": {
        "$ref": "primitives.schema.json#/$defs/StableId"
      },
      "uniqueItems": true
    },
    "evidence_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "session_id",
          "utterance_id",
          "revision",
          "start_ms",
          "end_ms",
          "start_at",
          "end_at",
          "text",
          "participant",
          "audio_ranges"
        ],
        "properties": {
          "session_id": {
            "$ref": "primitives.schema.json#/$defs/StableId"
          },
          "utterance_id": {
            "$ref": "primitives.schema.json#/$defs/StableId"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "start_at": {
            "type": "string"
          },
          "end_at": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "participant": {
            "type": "object",
            "required": [
              "key",
              "kind",
              "label",
              "status"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "self",
                  "known",
                  "unknown"
                ]
              },
              "label": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "person_id": {
                "$ref": "primitives.schema.json#/$defs/StableId"
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "audio_ranges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "salience": {
      "type": "integer",
      "minimum": 0
    },
    "reconciliation": {
      "type": "object"
    }
  }
}
