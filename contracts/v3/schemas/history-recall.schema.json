{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "history-recall.schema.json",
  "title": "Bounded history recall and explicit source identity operations",
  "$defs": {
    "Request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "query_id",
            "question"
          ],
          "properties": {
            "action": {
              "const": "query"
            },
            "query_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "keyword": {
              "type": "string",
              "maxLength": 100
            },
            "person_id": {
              "type": "string"
            },
            "source": {
              "enum": [
                "all",
                "qq",
                "wechat",
                "recording"
              ]
            },
            "sent_from": {
              "type": "integer",
              "minimum": 0
            },
            "sent_to": {
              "type": "integer",
              "minimum": 0
            },
            "expand": {
              "type": "boolean"
            },
            "summarize": {
              "type": "boolean"
            },
            "timezone": {
              "type": "string",
              "maxLength": 100,
              "description": "User IANA timezone; legacy clients default to Asia/Singapore"
            },
            "previous_query_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "const": "catalog"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "query_id"
          ],
          "properties": {
            "action": {
              "const": "cancel"
            },
            "query_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "query_id",
            "page"
          ],
          "properties": {
            "action": {
              "const": "page"
            },
            "query_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            },
            "page": {
              "type": "integer",
              "minimum": 0,
              "maximum": 14
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "query_id",
            "evidence_id"
          ],
          "properties": {
            "action": {
              "const": "context"
            },
            "query_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            },
            "evidence_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "decision"
          ],
          "properties": {
            "action": {
              "const": "identity"
            },
            "decision": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation_id",
                "key",
                "person_id",
                "action",
                "basis",
                "version"
              ],
              "properties": {
                "operation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "key": {
                  "type": "string"
                },
                "person_id": {
                  "type": "string"
                },
                "action": {
                  "enum": [
                    "link",
                    "reject",
                    "unlink"
                  ]
                },
                "basis": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "version": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "query_id",
            "contact_key"
          ],
          "properties": {
            "action": {
              "const": "choose"
            },
            "query_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            },
            "contact_key": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "query_id"
          ],
          "properties": {
            "action": {
              "const": "contacts"
            },
            "query_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            },
            "search": {
              "type": "string",
              "maxLength": 100
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4980
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "query_id"
          ],
          "properties": {
            "action": {
              "const": "retry_summary"
            },
            "query_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,80}$"
            }
          }
        }
      ]
    },
    "Response": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "query_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,80}$"
        },
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "source_is_from_self": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Original source fact, not current ownership."
              },
              "effective_is_self": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Current effective identity; manual correction/unlink takes priority."
              },
              "validity": {
                "enum": [
                  "valid",
                  "stale"
                ]
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "maxItems": 20
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "metrics": {
          "type": "object"
        },
        "model_status": {
          "type": "string"
        },
        "scope": {
          "type": "object"
        },
        "intent": {
          "enum": [
            "quote",
            "reason",
            "timeline",
            "latest",
            "conversation"
          ]
        },
        "latest_status_confirmed": {
          "type": "boolean"
        },
        "invalidated_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "person_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "person_id",
              "display_name"
            ],
            "properties": {
              "person_id": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              }
            }
          }
        },
        "source_status": {
          "type": "string"
        },
        "query_understanding": {
          "type": "object"
        },
        "contact_candidates": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "key",
              "platform",
              "display_name"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "platform": {
                "enum": [
                  "qq",
                  "wechat"
                ]
              },
              "display_name": {
                "type": "string"
              },
              "names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "conversation_type": {
                "enum": [
                  "c2c",
                  "group"
                ]
              }
            }
          }
        },
        "contact_lookup_allowed": {
          "type": "boolean"
        },
        "summary_retry_available": {
          "type": "boolean"
        }
      }
    }
  },
  "description": "Business-read-only scoped recall. Initial query: 60 seconds, 300 records, 12 source requests (6 directory plus 6 retrieval), at most one planner and one summary. Summary at most 45 seconds. An explicit retry uses the owned, still-valid evidence, once, with no source reads. Explicit directory lookup: at most two refreshes of 6 metadata requests each, 20 contacts per page, no message reads, no person/alias writes. Unknown time/source constraints cannot be bypassed by contact selection. Coverage remains partial and citations are verified."
}
