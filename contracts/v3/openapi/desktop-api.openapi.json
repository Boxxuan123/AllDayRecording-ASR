{
  "openapi": "3.1.0",
  "info": {
    "title": "AllDayRecording Desktop API",
    "version": "3.5.0",
    "description": "Loopback-only query, media, correction, durable-processing, knowledge, reminder, open-set speaker identity, and cross-day person memory API for the independent Desktop frontend."
  },
  "servers": [{"url": "http://127.0.0.1:8766"}],
  "security": [{"DesktopSession": []}],
  "paths": {
    "/api/v3/status": {"get": {"operationId": "getDesktopStatus", "responses": {"200": {"description": "V3 runtime status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuntimeStatus"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}},
    "/api/v3/overview": {"get": {"operationId": "getDesktopOverview", "responses": {"200": {"description": "Desktop overview projection", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectProjection"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}},
    "/api/v3/recording-sessions": {
      "get": {
        "operationId": "listRecordingSessions",
        "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}],
        "responses": {
          "200": {"description": "Opaque keyset-paginated recording session page", "content": {"application/json": {"schema": {"type": "object", "required": ["items", "next_cursor"], "properties": {"items": {"type": "array", "items": {"$ref": "../schemas/recording-session.schema.json"}}, "next_cursor": {"type": ["string", "null"]}}}}}},
          "default": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/v3/recording-sessions/{session_id}": {
      "parameters": [{"$ref": "#/components/parameters/SessionId"}],
      "get": {"operationId": "getRecordingSessionDetail", "responses": {"200": {"description": "Session, segments, runs, utterances, artifacts, and backup evidence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionDetail"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/processing-jobs": {
      "get": {"operationId": "listProcessingJobs", "parameters": [{"$ref": "#/components/parameters/Status"}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Durable processing job list", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/processing-jobs/{job_id}": {
      "parameters": [{"$ref": "#/components/parameters/JobId"}],
      "get": {"operationId": "getProcessingJob", "responses": {"200": {"description": "Durable job, run, stage, and attempt snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProcessingSnapshot"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/processing-jobs/{job_id}/retry": {
      "parameters": [{"$ref": "#/components/parameters/JobId"}],
      "post": {"operationId": "retryProcessingJob", "responses": {"202": {"description": "Requeued durable snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProcessingSnapshot"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/processing-jobs/{job_id}/cancel": {
      "parameters": [{"$ref": "#/components/parameters/JobId"}],
      "post": {
        "operationId": "cancelProcessingJob",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}}}}}},
        "responses": {"202": {"description": "Cancellation snapshot", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProcessingSnapshot"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}
      }
    },
    "/api/v3/processing-runs/{run_id}": {
      "get": {"operationId": "getProcessingRun", "parameters": [{"$ref": "#/components/parameters/RunId"}], "responses": {"200": {"description": "Durable processing run projection", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectProjection"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/reviews": {"get": {"operationId": "listReviewItems", "parameters": [{"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Waiting-review stage list", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}},
    "/api/v3/utterances/{utterance_id}/corrections": {
      "parameters": [{"$ref": "#/components/parameters/UtteranceId"}],
      "post": {
        "operationId": "correctUtterance",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["expected_revision", "text", "speaker_track_id", "identity"], "properties": {"expected_revision": {"$ref": "../schemas/primitives.schema.json#/$defs/Revision"}, "text": {"type": "string"}, "speaker_track_id": {"oneOf": [{"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}, {"type": "null"}]}, "identity": {"type": "string", "enum": ["self", "not_self", "unknown"]}}}}}},
        "responses": {"200": {"description": "Canonical corrected Utterance DTO", "content": {"application/json": {"schema": {"$ref": "../schemas/utterance.schema.json"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}
      },
      "get": {"operationId": "getUtteranceCorrectionHistory", "responses": {"200": {"description": "Current utterance and immutable correction operations", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/persons": {
      "get": {"operationId": "listPeople", "responses": {"200": {"description": "Explicitly confirmed local people with stable prototype counts", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "../schemas/person.schema.json#/$defs/Person"}}}}}}}, "default": {"$ref": "#/components/responses/ApiError"}}},
      "post": {"operationId": "createPerson", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["display_name"], "properties": {"display_name": {"type": "string", "minLength": 1}, "kind": {"type": "string", "enum": ["self", "known"], "default": "known"}}}}}}, "responses": {"201": {"description": "Created local person", "content": {"application/json": {"schema": {"$ref": "../schemas/person.schema.json#/$defs/Person"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/persons/{person_id}": {
      "get": {"operationId": "getPersonMemoryDetail", "parameters": [{"name": "person_id", "in": "path", "required": true, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Cross-day profile, interaction timeline, evidence-linked memories, commitments, and topics", "content": {"application/json": {"schema": {"$ref": "../schemas/person-memory.schema.json#/$defs/PersonDetail"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/persons/{person_id}/profile": {
      "post": {"operationId": "revisePersonProfile", "parameters": [{"name": "person_id", "in": "path", "required": true, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../schemas/person-memory.schema.json#/$defs/ProfileUpdate"}}}}, "responses": {"200": {"description": "New immutable person profile revision", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/persons/{person_id}/memories": {
      "post": {"operationId": "createPersonMemory", "parameters": [{"name": "person_id", "in": "path", "required": true, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../schemas/person-memory.schema.json#/$defs/MemoryDraft"}}}}, "responses": {"201": {"description": "Evidence-linked immutable person memory revision", "content": {"application/json": {"schema": {"$ref": "../schemas/person-memory.schema.json#/$defs/PersonMemory"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/persons/{person_id}/memories/refresh": {
      "post": {"operationId": "refreshPersonMemories", "parameters": [{"name": "person_id", "in": "path", "required": true, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}], "responses": {"200": {"description": "Deterministic event-layer projection and expiry receipt", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/person-memories/{memory_id}/revise": {
      "post": {"operationId": "revisePersonMemory", "parameters": [{"name": "memory_id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../schemas/person-memory.schema.json#/$defs/MemoryRevision"}}}}, "responses": {"200": {"description": "New immutable person memory revision", "content": {"application/json": {"schema": {"$ref": "../schemas/person-memory.schema.json#/$defs/PersonMemory"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/person-memories/{memory_id}/expire": {
      "post": {"operationId": "expirePersonMemory", "parameters": [{"name": "memory_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Expired person memory revision", "content": {"application/json": {"schema": {"$ref": "../schemas/person-memory.schema.json#/$defs/PersonMemory"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/person-memories/{memory_id}/retract": {
      "post": {"operationId": "retractPersonMemory", "parameters": [{"name": "memory_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Retracted person memory revision", "content": {"application/json": {"schema": {"$ref": "../schemas/person-memory.schema.json#/$defs/PersonMemory"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/person-memories/{memory_id}/undo": {
      "post": {"operationId": "undoPersonMemoryOperation", "parameters": [{"name": "memory_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Append-only person memory undo revision", "content": {"application/json": {"schema": {"$ref": "../schemas/person-memory.schema.json#/$defs/PersonMemory"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/speaker-cluster-runs": {
      "post": {"operationId": "analyzeSpeakerClusters", "description": "Extract local speaker embeddings and conservatively match anonymous clusters. A known-person match is suggestion-only.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["session_id"], "properties": {"session_id": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}}}}}, "responses": {"200": {"description": "Completed local cluster run", "content": {"application/json": {"schema": {"$ref": "../schemas/person.schema.json#/$defs/ClusterRunResult"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/speaker-clusters": {
      "get": {"operationId": "listSpeakerClusters", "parameters": [{"name": "status", "in": "query", "required": false, "schema": {"$ref": "../schemas/person.schema.json#/$defs/ClusterStatus"}}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Desktop-only anonymous and labeled cluster review list", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "../schemas/person.schema.json#/$defs/SpeakerCluster"}}}}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/speaker-clusters/{cluster_id}": {
      "get": {"operationId": "getSpeakerCluster", "parameters": [{"$ref": "#/components/parameters/ClusterId"}], "responses": {"200": {"description": "Cluster members, representative clips, prototypes, and immutable operations", "content": {"application/json": {"schema": {"$ref": "../schemas/person.schema.json#/$defs/SpeakerCluster"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/speaker-clusters/{cluster_id}/label": {
      "post": {"operationId": "labelSpeakerCluster", "parameters": [{"$ref": "#/components/parameters/ClusterId"}], "description": "Explicit user confirmation links a person and publishes multiple immutable stable prototypes.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["person_id"], "properties": {"person_id": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}}, {"type": "object", "additionalProperties": false, "required": ["display_name"], "properties": {"display_name": {"type": "string", "minLength": 1}}}]}}}}, "responses": {"200": {"description": "Label operation and event-reference rebind receipt", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/speaker-clusters/{cluster_id}/merge": {
      "post": {"operationId": "mergeSpeakerClusters", "parameters": [{"$ref": "#/components/parameters/ClusterId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["source_cluster_ids"], "properties": {"source_cluster_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}}}}}}, "responses": {"200": {"description": "Reversible merge receipt", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/speaker-clusters/{cluster_id}/split": {
      "post": {"operationId": "splitSpeakerCluster", "parameters": [{"$ref": "#/components/parameters/ClusterId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["speaker_track_ids"], "properties": {"speaker_track_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}}}}}}, "responses": {"200": {"description": "Reversible split receipt", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/speaker-clusters/{cluster_id}/ignore": {
      "post": {"operationId": "ignoreSpeakerCluster", "parameters": [{"$ref": "#/components/parameters/ClusterId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}}}}}}, "responses": {"200": {"description": "Media or environment exclusion receipt", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/speaker-clusters/{cluster_id}/undo": {
      "post": {"operationId": "undoSpeakerClusterOperation", "parameters": [{"$ref": "#/components/parameters/ClusterId"}], "responses": {"200": {"description": "Append-only undo receipt", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/devices": {"get": {"operationId": "listDesktopDevices", "responses": {"200": {"description": "Paired and known devices", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}},
    "/api/v3/data-health": {"get": {"operationId": "getDataHealth", "responses": {"200": {"description": "Local storage, replica, backup, and artifact counts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectProjection"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}},
    "/api/v3/settings": {"get": {"operationId": "getDesktopSettings", "responses": {"200": {"description": "Read-only local deployment and privacy policy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectProjection"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}},
    "/api/v3/lab": {"get": {"operationId": "getLabBoundary", "responses": {"200": {"description": "Explicit disabled-by-default Lab boundary", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectProjection"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}},
    "/api/v3/media/{media_id}": {
      "get": {"operationId": "readMediaRange", "parameters": [{"$ref": "#/components/parameters/MediaId"}, {"name": "Range", "in": "header", "required": false, "schema": {"type": "string"}}], "responses": {"200": {"description": "Complete media bytes"}, "206": {"description": "Requested media byte range"}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/evidence-spans": {
      "get": {"operationId": "listEvidenceSpans", "parameters": [{"name": "session_id", "in": "query", "required": true, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}], "responses": {"200": {"description": "Materialized layer-one evidence spans", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "../schemas/knowledge.schema.json#/$defs/EvidenceSpan"}}}}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/events": {
      "get": {"operationId": "listCurrentEvents", "parameters": [{"name": "session_id", "in": "query", "required": true, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}], "responses": {"200": {"description": "Layer-two event current states", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "../schemas/knowledge.schema.json#/$defs/EventState"}}}}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/events/{event_id}/operations": {
      "get": {"operationId": "listEventOperations", "parameters": [{"name": "event_id", "in": "path", "required": true, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}], "responses": {"200": {"description": "Immutable layer-two event operation history", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "../schemas/knowledge.schema.json#/$defs/EventOperation"}}}}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/memories": {
      "get": {"operationId": "listMemoryRecords", "parameters": [{"name": "session_id", "in": "query", "required": false, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}, {"name": "subject_type", "in": "query", "required": false, "schema": {"type": "string"}}, {"name": "subject_id", "in": "query", "required": false, "schema": {"type": "string"}}], "responses": {"200": {"description": "Versioned layer-three memory and interpretation records", "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "../schemas/knowledge.schema.json#/$defs/MemoryRecord"}}}}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/knowledge-generations": {
      "post": {"operationId": "submitKnowledgeGeneration", "description": "Validate and persist structured proposals without mutating event or memory state.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../schemas/knowledge.schema.json#/$defs/GenerationSubmission"}}}}, "responses": {"202": {"description": "Generation provenance and pending proposal identities", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/knowledge-proposals": {
      "get": {"operationId": "listKnowledgeProposals", "parameters": [{"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["pending", "accepted", "rejected"]}}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Structured proposal review queue", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/knowledge-proposals/{proposal_id}/accept": {
      "post": {"operationId": "acceptKnowledgeProposal", "parameters": [{"name": "proposal_id", "in": "path", "required": true, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}], "responses": {"200": {"description": "Accepted proposal and resulting resource", "content": {"application/json": {"schema": {"$ref": "../schemas/knowledge.schema.json#/$defs/ProposalResolution"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/knowledge-proposals/{proposal_id}/reject": {
      "post": {"operationId": "rejectKnowledgeProposal", "parameters": [{"name": "proposal_id", "in": "path", "required": true, "schema": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}}}}}}, "responses": {"200": {"description": "Rejected proposal receipt", "content": {"application/json": {"schema": {"$ref": "../schemas/knowledge.schema.json#/$defs/ProposalResolution"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/derivations/affected": {
      "get": {"operationId": "findAffectedDerivations", "parameters": [{"name": "source_type", "in": "query", "required": true, "schema": {"type": "string"}}, {"name": "source_id", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Transitive dependency closure", "content": {"application/json": {"schema": {"type": "object"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/invalidations": {
      "get": {"operationId": "listInvalidations", "parameters": [{"name": "target_type", "in": "query", "required": false, "schema": {"type": "string"}}, {"name": "target_id", "in": "query", "required": false, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Immutable invalidation history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/recompute-requests": {
      "get": {"operationId": "listRecomputeRequests", "parameters": [{"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"]}}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Durable recomputation queue", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/reminder-generations": {
      "post": {"operationId": "submitReminderGeneration", "description": "Persist validated reminder candidates; fail-closed policy decides review versus tightly gated auto-apply.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../schemas/reminder.schema.json#/$defs/GenerationSubmission"}}}}, "responses": {"202": {"description": "Generation provenance and classified candidates", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectProjection"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/reminder-generations/codex": {
      "post": {"operationId": "generateRemindersWithCodex", "description": "User-triggered reminder extraction from selected transcript text. Audio and local paths are never sent; Codex runs with denied approvals in an empty read-only working directory, and results enter the review queue by default.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["session_id"], "properties": {"session_id": {"$ref": "../schemas/primitives.schema.json#/$defs/StableId"}, "reasoning_effort": {"type": "string", "enum": ["auto", "low", "medium", "high", "xhigh"], "default": "auto"}}}}}}, "responses": {"202": {"description": "Codex generation provenance and validated review candidates", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectProjection"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/reminder-candidates": {
      "get": {"operationId": "listReminderCandidates", "parameters": [{"name": "status", "in": "query", "required": false, "schema": {"$ref": "../schemas/reminder.schema.json#/$defs/CandidateStatus"}}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Reminder review queue with evidence playback metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/reminder-candidates/{candidate_id}": {
      "get": {"operationId": "getReminderCandidate", "parameters": [{"$ref": "#/components/parameters/CandidateId"}], "responses": {"200": {"description": "Reminder candidate with provenance and evidence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ObjectProjection"}}}}, "default": {"$ref": "#/components/responses/ApiError"}}}
    },
    "/api/v3/reminder-candidates/{candidate_id}/feedback": {
