# V3 stays disabled by default and does not replace any V2 entrypoint.
ALLDAY_V3_ENABLED=0
ALLDAY_V3_DEPLOYMENT=development

# Production releases must inject real values through the release environment.
# The validator rejects .local/.test/.example/.invalid, localhost and IP RP IDs.
ALLDAY_V3_PASSKEY_RP_ID=
ALLDAY_V3_PASSKEY_ORIGINS=
